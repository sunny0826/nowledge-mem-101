{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nowledge Mem 101",
  "description": "Learn to leave knowledge for your future self and your AI — by doing it for real.",
  "colors": {
    "primary": "#0075DE",
    "light": "#93B5DA",
    "dark": "#2383E2"
  },
  "fonts": {
    "body": {
      "family": "Inter"
    },
    "heading": {
      "family": "Inter"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#191919"
    }
  },
  "favicon": "/logo/nowledge-mem-logo.png",
  "logo": {
    "light": "/logo/wordmark-light.svg",
    "dark": "/logo/wordmark-dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "strict": true
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/cover-image/og-background.png"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/nowledge-co"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://mem.nowledge.co",
      "github": "https://github.com/nowledge-co",
      "x": "https://x.com/NowledgeMem"
    },
    "links": [
      {
        "header": "This tutorial",
        "items": [
          {
            "label": "Start here",
            "href": "/"
          },
          {
            "label": "Essentials",
            "href": "/essentials/index"
          }
        ]
      },
      {
        "header": "Product",
        "items": [
          {
            "label": "Nowledge Mem website",
            "href": "https://mem.nowledge.co"
          },
          {
            "label": "Full docs",
            "href": "https://mem.nowledge.co/docs"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "search": {
    "prompt": "Search the docs…"
  },
  "seo": {
    "metatags": {
      "twitter:site": "@NowledgeMem",
      "twitter:creator": "@NowledgeMem"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Getting started",
            "icon": "house",
            "pages": ["index"]
          },
          {
            "tab": "Essentials",
            "icon": "book-open",
            "pages": [
              "essentials/index",
              "essentials/first-memory",
              "essentials/recall-memory"
            ]
          }
        ]
      },
      {
        "language": "zh",
        "navbar": {
          "links": [
            {
              "type": "github",
              "href": "https://github.com/nowledge-co"
            }
          ]
        },
        "footer": {
          "socials": {
            "website": "https://mem.nowledge.co",
            "github": "https://github.com/nowledge-co",
            "x": "https://x.com/NowledgeMem"
          },
          "links": [
            {
              "header": "本教程",
              "items": [
                {
                  "label": "从这里开始",
                  "href": "/zh"
                },
                {
                  "label": "Essentials",
                  "href": "/zh/essentials/index"
                }
              ]
            },
            {
              "header": "产品",
              "items": [
                {
                  "label": "Nowledge Mem 官网",
                  "href": "https://mem.nowledge.co"
                },
                {
                  "label": "完整文档",
                  "href": "https://mem.nowledge.co/zh/docs"
                }
              ]
            }
          ]
        },
        "tabs": [
          {
            "tab": "开始使用",
            "icon": "house",
            "pages": ["zh/index"]
          },
          {
            "tab": "Essentials",
            "icon": "book-open",
            "pages": [
              "zh/essentials/index",
              "zh/essentials/first-memory",
              "zh/essentials/recall-memory"
            ]
          }
        ]
      }
    ]
  }
}
